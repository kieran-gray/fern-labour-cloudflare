{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "fern-labour-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-25",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "npm run build"
  },
  "workers_dev": false,
  "route": {
    "pattern": "admin.fernlabour.com",
    "custom_domain": true
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "services": [
    {
      "binding": "CONTACT_US_API",
      "service": "fern-labour-contact-us"
    },
    {
      "binding": "NOTIFICATIONS_API",
      "service": "fern-labour-notifications-worker"
    },
    {
      "binding": "NOTIFICATION_GENERATION_API",
      "service": "fern-labour-notification-generation-worker"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "env": {
    "dev": {
      "services": [
        {
          "binding": "CONTACT_US_API",
          "service": "fern-labour-contact-us-dev"
        },
        {
          "binding": "NOTIFICATIONS_API",
          "service": "fern-labour-notifications-worker-dev"
        },
        {
          "binding": "NOTIFICATION_GENERATION_API",
          "service": "fern-labour-notification-generation-worker-dev"
        }
      ],
      "vars": {
        "ENVIRONMENT": "dev"
      },
    }
  }
}