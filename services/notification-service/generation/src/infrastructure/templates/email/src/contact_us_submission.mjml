<mjml>
  <mj-head>
    <mj-font name="Poppins" href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&display=swap" />
    <mj-font name="Quicksand" href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="Quicksand, Helvetica, sans-serif" />
      <mj-text padding="0 24px" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#fffaf9">
    <mj-include path="./components/header.mjml" />

    <!-- Main Content -->
    <mj-section background-color="#fdfaf8" padding="40px 20px" border-radius="16px">
      <mj-column width="100%">
        <mj-text align="center" font-size="20px" font-weight="700" font-family="Poppins, Helvetica, sans-serif" color="#333333" padding="0 24px 20px">
          New Contact Form Submission
        </mj-text>
        <mj-text align="left" font-size="15px" font-weight="600" color="#555555" padding="0 24px 4px">
          Name:
        </mj-text>
        <mj-text align="left" font-size="15px" font-weight="400" color="#666666" padding="0 24px 16px">
          {name}
        </mj-text>
        <mj-text align="left" font-size="15px" font-weight="600" color="#555555" padding="0 24px 4px">
          Email:
        </mj-text>
        <mj-text align="left" font-size="15px" font-weight="400" color="#666666" padding="0 24px 16px">
          {email}
        </mj-text>
        <mj-text align="left" font-size="15px" font-weight="600" color="#555555" padding="0 24px 4px">
          User ID:
        </mj-text>
        <mj-text align="left" font-size="15px" font-weight="400" color="#666666" padding="0 24px 16px">
          {user_id}
        </mj-text>
        <mj-text align="left" font-size="15px" font-weight="600" color="#555555" padding="0 24px 4px">
          Message:
        </mj-text>
        <mj-text align="left" font-size="15px" font-weight="400" color="#666666" padding="0 24px 0">
          {message}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer (simplified for internal email) -->
    <mj-section padding="30px 20px">
      <mj-column width="100%">
        <mj-divider border-color="#ffeae6" border-width="1px" padding="0 0 20px" />
        <mj-text align="center" color="#999999" font-size="12px" padding="0">
          Internal notification from Fern Labour
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
